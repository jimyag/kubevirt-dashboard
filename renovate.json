{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "groupName": "Go"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump",
      "extractVersion": "^(?<version>\\d+\\.\\d+)\\.\\d+$",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "go"
      ],
      "enabled": true
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["kubevirt.io/**", "k8s.io/**", "sigs.k8s.io/**", "github.com/openshift/**"],
      "groupName": "KubeVirt and Kubernetes"
    },
    {
      "description": "kubevirt.io/client-go 1.9 imports client-go packages removed in Kubernetes 0.35 (autoscaling/v2beta1, scheduling/v1alpha1, storagemigration/v1alpha1); keep 0.34.x until a KubeVirt SDK release supports newer clients.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/api", "k8s.io/apimachinery", "k8s.io/apiextensions-apiserver", "k8s.io/client-go"],
      "allowedVersions": "<0.35.0"
    },
    {
      "description": "These are compatibility pins copied from the KubeVirt SDK go.mod; update them with the SDK rather than independently.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/openshift/api", "github.com/openshift/client-go", "k8s.io/kube-openapi"],
      "enabled": false
    }
  ]
}
